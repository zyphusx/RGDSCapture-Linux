<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════
         RGDSCapture — shared control styles.

         All colors come from the active theme dictionary via
         DynamicResource, so swapping themes restyles everything live.

         ── THE SYSTEM ───────────────────────────────────────────────

         Everything below is built from four scales and nothing else. A
         value that is not on one of them is a mistake, not a nuance.

           Type      11 · 13 · 15 · 28           four sizes, one family
           Space     4 · 8 · 12 · 16 · 20 · 24   margins and gaps
           Radius    12 card · 8 control · 6 chip
           Height    32 control · 30 chip · 26 segment

         Heights come from MinHeight with vertically centred content,
         never from vertical padding. Padding-driven heights drift the
         moment two controls carry different font sizes or glyphs, which
         is exactly how a button, a text box and a picker in the same row
         ended up three different heights.

         ONE TYPEFACE — Inter, bundled with the app so it renders
         identically everywhere instead of resolving to whatever the host
         happens to have. Numeric readouts (the timer, log timestamps,
         network stats) do not switch to a monospace face: they set the
         "tnum" OpenType feature, which gives Inter fixed-width digits.
         Columns line up, a running timer does not jitter, and the app
         keeps one voice.

         ── PORTING NOTES ────────────────────────────────────────────

         Variants are style CLASSES, not keyed styles, so a control can
         carry two at once. State is expressed as pseudo-class SELECTORS,
         where "/template/" reaches into the template the way a WPF
         trigger's TargetName did.

         Controls whose structure we never changed (CheckBox, Slider,
         ScrollBar, Menu) are restyled over Fluent's templates rather
         than re-templated. Anything whose shape genuinely differs is
         templated in full.
    ════════════════════════════════════════════════════════════════ -->

    <Styles.Resources>
        <FontFamily x:Key="UiFont">Inter, Cantarell, Noto Sans, sans-serif</FontFamily>
    </Styles.Resources>

    <!-- Set once, at the window, and inherited. Repeating it per-window
         is how two of them ended up disagreeing. -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Fixed-width digits, for anything that reads as a number. -->
    <Style Selector="TextBlock.numeric">
        <Setter Property="FontFeatures" Value="+tnum"/>
    </Style>
    <Style Selector="TextBox.numeric">
        <Setter Property="FontFeatures" Value="+tnum"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         BUTTONS
    ═══════════════════════════════════════════════════════════ -->

    <!-- Default: quiet raised surface -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="ContentHost"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource BtnHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    </Style>
    <Style Selector="Button:pressed /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource BtnPress}"/>
    </Style>
    <Style Selector="Button:focus-visible /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Primary: the one main action on screen.

         Named "primary" rather than "accent" because Fluent already defines
         a Button.accent style of its own; sharing the name let it paint its
         system accent over ours.

         The fill stays a flat colour on purpose. A pride theme's stripes
         run across the border instead: text over a six-colour gradient
         cannot hold a contrast ratio (white on the rainbow's yellow band
         fails outright), whereas a 2px outline carries the whole flag
         safely. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary /template/ Border#Root">
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}"/>
    </Style>

    <!-- Only the fill reacts. Leaving BorderBrush alone keeps a pride
         theme's stripes on the outline through hover and press. -->
    <Style Selector="Button.primary:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGradient}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentPress}"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ Border#Root">
        <Setter Property="BoxShadow" Value="none"/>
    </Style>

    <!-- Ghost: no chrome until hovered. Sidebar workhorse. -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.ghost:pressed /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource BtnPress}"/>
    </Style>

    <!-- Icon: a ghost button squared off around a single glyph -->
    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Danger: destructive, but not shouting until hovered -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
    </Style>
    <Style Selector="Button.danger:pressed /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource DangerPress}"/>
    </Style>

    <!-- Record: the armed state is applied by the view as .recording -->
    <Style Selector="Button.record">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.record.recording">
        <Setter Property="Background" Value="{DynamicResource RecordingBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource RecordingFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RecordingBorder}"/>
    </Style>
    <Style Selector="Button.record.recording:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource RecordingHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RecordingBorder}"/>
    </Style>

    <!-- Active: a plain button showing that what it starts is running.
         Where the record button turns red, this one simply takes the accent,
         since audio monitoring is not a destructive state. -->
    <Style Selector="Button.active">
        <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.active:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBg}"/>
    </Style>

    <!-- Overlay: floats on the video, so it carries its own scrim -->
    <Style Selector="Button.overlay">
        <Setter Property="Background" Value="{DynamicResource OverlayBtnBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource OverlayBtnFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayBtnBorder}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.overlay:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource OverlayBtnHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayBtnBorder}"/>
    </Style>

    <!-- Caption: title-bar minimise / maximise / close. Square, no radius,
         full-height, and never focusable — clicking one must not move focus
         out of whatever the user was typing in. -->
    <Style Selector="Button.caption">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TitleBarFg}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="0">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.caption:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource CaptionBtnHover}"/>
    </Style>
    <Style Selector="Button.caption:pressed /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource CaptionBtnPress}"/>
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource CaptionCloseHover}"/>
    </Style>
    <Style Selector="Button.caption.close:pressed /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource CaptionClosePress}"/>
    </Style>
    <Style Selector="Button.caption.close:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         SEGMENTED CONTROLS
    ═══════════════════════════════════════════════════════════ -->

    <!-- Track that houses a row of segment radios -->
    <Style Selector="Border.segment-track">
        <Setter Property="Background" Value="{DynamicResource SegmentTrackBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SegmentBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{DynamicResource SegmentFg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource SegmentHoverBg}"/>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentSelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{DynamicResource SegmentSelFg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.segment:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- On/off chip. A real toggle, so ToggleButton is safe here: a
         re-click genuinely flips the underlying value. -->
    <Style Selector="ToggleButton.chip">
        <Setter Property="Foreground" Value="{DynamicResource SegmentFg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{DynamicResource SegmentTrackBg}"
                        BorderBrush="{DynamicResource SegmentBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.chip:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource SegmentHoverBg}"/>
    </Style>
    <Style Selector="ToggleButton.chip:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentSelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}"/>
    </Style>
    <Style Selector="ToggleButton.chip:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentSubtleFg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ToggleButton.chip:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         CHECKBOX — Fluent's template, our palette
    ═══════════════════════════════════════════════════════════ -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderHover}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBg}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource AccentFg}"/>
        <Setter Property="Stroke" Value="{DynamicResource AccentFg}"/>
    </Style>
    <Style Selector="CheckBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         TEXT INPUT

         PasswordBox has no Avalonia counterpart — a TextBox with
         PasswordChar set is the whole of it — so the WPF PasswordBox
         style folds into this one.
    ═══════════════════════════════════════════════════════════ -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InputCaret}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentMuted}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderHover}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         COMBOBOX
    ═══════════════════════════════════════════════════════════ -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="PlaceholderForeground" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderHover}"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
    </Style>
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource MenuPopupBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MenuHoverBg}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSelBg}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentSubtleFg}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         SLIDER
    ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Slider">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Slider /template/ Border#TrackBackground">
        <Setter Property="Background" Value="{DynamicResource SliderTrackBg}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Height" Value="4"/>
    </Style>
    <Style Selector="Slider /template/ Rectangle#PART_SelectedRangeRectangle">
        <Setter Property="Fill" Value="{DynamicResource AccentBg}"/>
    </Style>
    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBg}"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
    </Style>
    <Style Selector="Slider:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         MENU
    ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuHoverBg}"/>
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuHoverBg}"/>
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="MenuItem /template/ Path#PART_ToggleIcon">
        <Setter Property="Fill" Value="{DynamicResource AccentBg}"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter, ContextMenu">
        <Setter Property="Background" Value="{DynamicResource MenuPopupBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource MenuSeparator}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,4"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         SCROLLBAR
    ═══════════════════════════════════════════════════════════ -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollThumb}"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="8"/>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="8"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         TOOLTIP
    ═══════════════════════════════════════════════════════════ -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TooltipBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TooltipFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         LAYOUT PRIMITIVES
    ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Border.sidebar-surface">
        <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    </Style>

    <!-- One grouped block inside a column.

         A hairline, not the accent outline the Windows build puts here.
         Eight cards each ringed in accent and carrying a glow is the
         loudest thing on screen and flattens the hierarchy — everything
         shouts, so nothing reads as primary. The accent now appears only
         where it means something: the primary action, and the selected
         segment. A pride theme still runs its flag across both.
    -->
    <Style Selector="Border.sidebar-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Hairline divider inside a card -->
    <Style Selector="Border.card-divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

    <!-- Uppercase group heading -->
    <Style Selector="TextBlock.section-header">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.5"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Label above a field -->
    <Style Selector="TextBlock.field-label">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Inline label sitting beside a control -->
    <Style Selector="TextBlock.section-label">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- Readout value, e.g. "85%" -->
    <Style Selector="TextBlock.value-text">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFeatures" Value="+tnum"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</Styles>
