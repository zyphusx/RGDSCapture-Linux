<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RGDSCapture.ViewModels"
             xmlns:core="using:RGDSCapture.Core"
             xmlns:ac="using:Avalonia.Controls"
             x:Class="RGDSCapture.Views.Controls.DevicePanel"
             x:DataType="vm:MainViewModel">

    <!--
        Left column. DataContext: MainViewModel.
        Everything here is "how the session is set up" — which device,
        how the streams are encoded, how the picture is arranged.
        The capture/performance controls live in CapturePanel.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="12,12,12,12">
        <StackPanel>

            <!-- ══ Connection ══════════════════════════════════════ -->
            <Border Classes="sidebar-card">
                <StackPanel>
                    <TextBlock Text="CONNECTION" Classes="section-header"/>

                    <TextBlock Text="Device" Classes="field-label"/>
                    <ComboBox IsEnabled="{Binding IsDisconnected}"
                              SelectedValueBinding="{Binding Tag, DataType=ac:ComboBoxItem}"
                              SelectedValue="{Binding DeviceType}"
                              Margin="0,0,0,10"
                              AutomationProperties.Name="Device type"
                              ToolTip.Tip="Which Anbernic device this is">
                        <!-- Tagged with the enum value, not its name: WPF's
                             binding engine coerces a string to an enum on the
                             way through, Avalonia's does not. -->
                        <ComboBoxItem Content="RG DS (dual-screen)"
                                      Tag="{x:Static core:DeviceType.RgDualScreen}"/>
                        <ComboBoxItem Content="RG353V (single-screen)"
                                      Tag="{x:Static core:DeviceType.Rg353V}"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Address" Classes="field-label"/>
                            <TextBox Text="{Binding DeviceIp}"
                                     IsEnabled="{Binding IsDisconnected}"
                                     AutomationProperties.Name="Device IP Address"
                                     ToolTip.Tip="IP address of your device"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Classes="field-label"/>
                            <TextBox Text="{Binding SshPortText}"
                                     IsEnabled="{Binding IsDisconnected}"
                                     AutomationProperties.Name="SSH Port"
                                     ToolTip.Tip="SSH port (usually 22)"/>
                        </StackPanel>
                    </Grid>

                    <Button Classes="accent"
                            Content="{Binding ConnectButtonText}"
                            Command="{Binding ConnectCommand}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Connect to device"
                            ToolTip.Tip="SSH into the device and start streams"/>

                    <Border Classes="card-divider"/>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{Binding StatusDotBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ConnectionLabel}"
                                   Classes="value-text"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ Streams ═════════════════════════════════════════ -->
            <Border Classes="sidebar-card">
                <StackPanel>
                    <TextBlock Text="STREAMS" Classes="section-header"/>

                    <TextBlock Text="Restart" Classes="field-label"/>
                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,12">
                        <Button Content="↺ Top"
                                Command="{Binding RestartTopCommand}"
                                Margin="0,0,4,0"
                                FontSize="12" Padding="4,7"
                                AutomationProperties.Name="Restart top stream"
                                ToolTip.Tip="Restart top screen stream  (F6)"/>
                        <Button Content="↺ Bot"
                                Command="{Binding RestartBottomCommand}"
                                Margin="2,0,2,0"
                                FontSize="12" Padding="4,7"
                                AutomationProperties.Name="Restart bottom stream"
                                ToolTip.Tip="Restart bottom screen stream  (F7)"/>
                        <Button Content="↺ All"
                                Command="{Binding RestartAllCommand}"
                                Margin="4,0,0,0"
                                FontSize="12" Padding="4,7"
                                AutomationProperties.Name="Restart all streams"
                                ToolTip.Tip="Restart all streams  (F5)"/>
                    </UniformGrid>

                    <TextBlock Text="Quality" Classes="field-label"/>
                    <Border Classes="segment-track">
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton Classes="segment"
                                         GroupName="Quality"
                                         Content="Low"
                                         IsChecked="{Binding IsQualityLow, Mode=OneWay}"
                                         Command="{Binding SetQualityCommand}"
                                         CommandParameter="Low"
                                         ToolTip.Tip="1 Mbps per screen — congested WiFi"/>
                            <RadioButton Classes="segment"
                                         GroupName="Quality"
                                         Content="Medium"
                                         IsChecked="{Binding IsQualityMedium, Mode=OneWay}"
                                         Command="{Binding SetQualityCommand}"
                                         CommandParameter="Medium"
                                         ToolTip.Tip="2 Mbps per screen — default"/>
                            <RadioButton Classes="segment"
                                         GroupName="Quality"
                                         Content="High"
                                         IsChecked="{Binding IsQualityHigh, Mode=OneWay}"
                                         Command="{Binding SetQualityCommand}"
                                         CommandParameter="High"
                                         ToolTip.Tip="4 Mbps per screen — strong network"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ Display ═════════════════════════════════════════ -->
            <Border Classes="sidebar-card">
                <StackPanel>
                    <TextBlock Text="DISPLAY" Classes="section-header"/>

                    <!-- Layout: five modes, so two rows rather than a strip -->
                    <TextBlock Text="Layout" Classes="field-label"
                               IsEnabled="{Binding IsDualScreenDevice}"/>
                    <Border Classes="segment-track"
                            IsEnabled="{Binding IsDualScreenDevice}"
                            Margin="0,0,0,12">
                        <UniformGrid Rows="2" Columns="3">
                            <RadioButton Classes="segment"
                                         GroupName="Layout"
                                         Content="Stack"
                                         IsChecked="{Binding IsLayoutVertical, Mode=OneWay}"
                                         Command="{Binding SetLayoutCommand}"
                                         CommandParameter="VerticalStack"
                                         ToolTip.Tip="Vertical stack — top over bottom"/>
                            <RadioButton Classes="segment"
                                         GroupName="Layout"
                                         Content="Side"
                                         IsChecked="{Binding IsLayoutSideBySide, Mode=OneWay}"
                                         Command="{Binding SetLayoutCommand}"
                                         CommandParameter="SideBySide"
                                         ToolTip.Tip="Side by side"/>
                            <RadioButton Classes="segment"
                                         GroupName="Layout"
                                         Content="Hybrid"
                                         IsChecked="{Binding IsLayoutHybrid, Mode=OneWay}"
                                         Command="{Binding SetLayoutCommand}"
                                         CommandParameter="Hybrid"
                                         ToolTip.Tip="melonDS-style — one large, one small"/>
                            <RadioButton Classes="segment"
                                         GroupName="Layout"
                                         Content="Top"
                                         IsChecked="{Binding IsLayoutTopOnly, Mode=OneWay}"
                                         Command="{Binding SetLayoutCommand}"
                                         CommandParameter="TopOnly"
                                         ToolTip.Tip="Top screen only"/>
                            <RadioButton Classes="segment"
                                         GroupName="Layout"
                                         Content="Bottom"
                                         IsChecked="{Binding IsLayoutBottomOnly, Mode=OneWay}"
                                         Command="{Binding SetLayoutCommand}"
                                         CommandParameter="BottomOnly"
                                         ToolTip.Tip="Bottom screen only"/>
                            <ToggleButton Classes="chip"
                                          Content="Swap"
                                          Margin="1"
                                          IsChecked="{Binding IsSwapped, Mode=OneWay}"
                                          Command="{Binding ToggleSwapCommand}"
                                          ToolTip.Tip="Swap which screen takes the primary position"/>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="Rotation" Classes="field-label"/>
                    <Border Classes="segment-track" Margin="0,0,0,12">
                        <UniformGrid Rows="1" Columns="4">
                            <RadioButton Classes="segment"
                                         GroupName="Rotation" Content="0°"
                                         IsChecked="{Binding IsRotation0, Mode=OneWay}"
                                         Command="{Binding SetRotationCommand}"
                                         CommandParameter="0"/>
                            <RadioButton Classes="segment"
                                         GroupName="Rotation" Content="90°"
                                         IsChecked="{Binding IsRotation90, Mode=OneWay}"
                                         Command="{Binding SetRotationCommand}"
                                         CommandParameter="90"
                                         ToolTip.Tip="90° clockwise"/>
                            <RadioButton Classes="segment"
                                         GroupName="Rotation" Content="180°"
                                         IsChecked="{Binding IsRotation180, Mode=OneWay}"
                                         Command="{Binding SetRotationCommand}"
                                         CommandParameter="180"/>
                            <RadioButton Classes="segment"
                                         GroupName="Rotation" Content="270°"
                                         IsChecked="{Binding IsRotation270, Mode=OneWay}"
                                         Command="{Binding SetRotationCommand}"
                                         CommandParameter="270"
                                         ToolTip.Tip="90° counter-clockwise"/>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="Screen gap" Classes="field-label"
                               IsEnabled="{Binding IsDualScreenDevice}"/>
                    <Border Classes="segment-track"
                            IsEnabled="{Binding IsDualScreenDevice}"
                            Margin="0,0,0,12">
                        <UniformGrid Rows="1" Columns="4">
                            <RadioButton Classes="segment"
                                         GroupName="Gap" Content="None"
                                         IsChecked="{Binding IsGapNone, Mode=OneWay}"
                                         Command="{Binding SetScreenGapCommand}"
                                         CommandParameter="0"/>
                            <RadioButton Classes="segment"
                                         GroupName="Gap" Content="S"
                                         IsChecked="{Binding IsGapSmall, Mode=OneWay}"
                                         Command="{Binding SetScreenGapCommand}"
                                         CommandParameter="4"/>
                            <RadioButton Classes="segment"
                                         GroupName="Gap" Content="M"
                                         IsChecked="{Binding IsGapNormal, Mode=OneWay}"
                                         Command="{Binding SetScreenGapCommand}"
                                         CommandParameter="8"/>
                            <RadioButton Classes="segment"
                                         GroupName="Gap" Content="L"
                                         IsChecked="{Binding IsGapWide, Mode=OneWay}"
                                         Command="{Binding SetScreenGapCommand}"
                                         CommandParameter="16"/>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="Scaling" Classes="field-label"/>
                    <Border Classes="segment-track" Margin="0,0,0,12">
                        <UniformGrid Rows="1" Columns="2">
                            <RadioButton Classes="segment"
                                         GroupName="Scaling" Content="Sharp"
                                         IsChecked="{Binding IsScalingSharp, Mode=OneWay}"
                                         Command="{Binding SetScalingCommand}"
                                         CommandParameter="Sharp"
                                         ToolTip.Tip="Pixel-perfect nearest-neighbour"/>
                            <RadioButton Classes="segment"
                                         GroupName="Scaling" Content="Smooth"
                                         IsChecked="{Binding IsScalingSmooth, Mode=OneWay}"
                                         Command="{Binding SetScalingCommand}"
                                         CommandParameter="Smooth"
                                         ToolTip.Tip="Filtered smooth scaling"/>
                        </UniformGrid>
                    </Border>

                    <Button Command="{Binding OpenThemePickerCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            FontSize="12" Padding="10,7"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Open theme picker"
                            ToolTip.Tip="Choose a theme preset or a custom accent colour  (Ctrl+T)">
                        <DockPanel LastChildFill="False" Width="196">
                            <Ellipse DockPanel.Dock="Left"
                                     Width="12" Height="12"
                                     Fill="{DynamicResource AccentGradient}"
                                     Stroke="{DynamicResource BorderStrong}"
                                     StrokeThickness="1"
                                     VerticalAlignment="Center"
                                     Margin="0,0,9,0"/>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding ThemeName}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="›"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>

                    <UniformGrid Rows="1" Columns="2">
                        <ToggleButton Classes="chip"
                                      Content="Stats"
                                      Margin="0,0,4,0"
                                      IsChecked="{Binding IsStatsVisible, Mode=OneWay}"
                                      Command="{Binding ToggleStatsCommand}"
                                      ToolTip.Tip="Show the per-screen bitrate / packet-loss overlay"/>
                        <ToggleButton Classes="chip"
                                      Content="Log"
                                      Margin="4,0,0,0"
                                      IsChecked="{Binding Log.IsOpen, Mode=OneWay}"
                                      Command="{Binding Log.ToggleCommand}"
                                      ToolTip.Tip="Show / hide the event log  (F8)"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ══ Console power ═══════════════════════════════════ -->
            <Border Classes="sidebar-card">
                <StackPanel>
                    <TextBlock Text="CONSOLE" Classes="section-header"/>
                    <UniformGrid Rows="1" Columns="2">
                        <Button Content="Shutdown"
                                Classes="danger"
                                Command="{Binding ShutdownCommand}"
                                Margin="0,0,4,0"
                                FontSize="12" Padding="4,7"
                                AutomationProperties.Name="Shutdown console"
                                ToolTip.Tip="Send shutdown command to the console"/>
                        <Button Content="Reboot"
                                Classes="danger"
                                Command="{Binding RebootCommand}"
                                Margin="4,0,0,0"
                                FontSize="12" Padding="4,7"
                                AutomationProperties.Name="Reboot console"
                                ToolTip.Tip="Send reboot command to the console"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
