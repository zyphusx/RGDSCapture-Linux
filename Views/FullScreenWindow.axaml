<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RGDSCapture.Views.Controls"
        xmlns:views="using:RGDSCapture.Views"
        xmlns:vm="using:RGDSCapture.ViewModels"
        x:Class="RGDSCapture.Views.FullScreenWindow"
        x:DataType="views:FullscreenContext"
        Title="RGDSCapture — Fullscreen"
        Icon="/Assets/icon.png"
        SystemDecorations="None"
        WindowState="FullScreen"
        CanResize="False"
        Background="Black"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="Inter,Cantarell,Noto Sans,sans-serif">

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding Main.RestartAllCommand}"/>
        <KeyBinding Gesture="F6" Command="{Binding Main.RestartTopCommand}"/>
        <KeyBinding Gesture="F7" Command="{Binding Main.RestartBottomCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Chrome fades out three seconds after the window opens and comes
             back on mouse-over, so a still picture is never boxed in by it.

             WPF drives this with an enter/exit storyboard pair plus a Loaded
             EventTrigger. Here it is one opacity transition between two
             states, with the initial fade started from code-behind: a
             selector can express "hovered", but not "three seconds after
             opening". -->
        <Style Selector="Grid#Chrome">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseIn"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid#Chrome.hidden">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Grid#Chrome.shown">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid Name="Root" Background="Black">

        <!-- DataContext is the screen, so Source is relative to it. -->
        <controls:VideoSurface Name="Video"
                               DataContext="{Binding Screen}"
                               Source="{Binding Bitmap, DataType=vm:ScreenViewModel}"/>

        <Grid Name="Chrome">
            <!--
                UI scale is applied to each overlay rather than to the Chrome
                grid: the grid is stretch-filled, so scaling it would grow it
                past the screen and carry the edge-anchored overlays off with
                it. The video itself is deliberately left unscaled — it should
                always fill the display.
            -->

            <!-- Screen identity + health, top-left -->
            <LayoutTransformControl LayoutTransform="{DynamicResource UiScaleTransform}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="20">
                <Border Background="{DynamicResource ScreenGlassBg}"
                        BorderBrush="{DynamicResource ScreenGlassBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Screen.BadgeText}"
                                   Foreground="{Binding Screen.BadgeBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Width="1" Height="14"
                                Background="{DynamicResource ScreenGlassBorder}"
                                Margin="12,0"/>
                        <TextBlock Text="{Binding Screen.DisplayName}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Screen.FpsText}"
                                   Foreground="#C8FFFFFF"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>
            </LayoutTransformControl>

            <!-- Close, top-right -->
            <LayoutTransformControl LayoutTransform="{DynamicResource UiScaleTransform}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="20">
                <Button Name="BtnClose"
                        Content="✕"
                        Classes="overlay"
                        Width="38" Height="38"
                        FontSize="16"
                        AutomationProperties.Name="Close fullscreen"/>
            </LayoutTransformControl>

            <!-- Hint, bottom-centre -->
            <LayoutTransformControl LayoutTransform="{DynamicResource UiScaleTransform}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,32">
                <Border Background="{DynamicResource ScreenGlassBg}"
                        BorderBrush="{DynamicResource ScreenGlassBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,7">
                    <TextBlock Text="ESC or double-click to exit   ·   F5 / F6 / F7 restart streams"
                               Foreground="#C8FFFFFF"
                               FontSize="12"/>
                </Border>
            </LayoutTransformControl>
        </Grid>

    </Grid>
</Window>
